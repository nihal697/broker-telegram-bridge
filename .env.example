# Copy to .env and fill in. Never commit .env.

# Broker selection — any broker that emits order updates works.
# Core is broker-agnostic; Dhan is the reference adapter included.
BROKER=dhan
# Generic (aliases below still work for backward compat)
BROKER_CLIENT_ID=
BROKER_ACCESS_TOKEN=

# Dhan example (also maps to BROKER_* when BROKER=dhan)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# PIN + TOTP_SECRET optional — Dhan self-healing refresh after 24h expiry.
DHAN_PIN=
DHAN_TOTP_SECRET=

# Angel One example — uncomment if BROKER=angel
# ANGEL_API_KEY=
# ANGEL_CLIENT_ID=
# ANGEL_PASSWORD=
# ANGEL_TOTP_SECRET=

# Zerodha Kite example — uncomment if BROKER=kite
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1000000000000
TELEGRAM_ADMIN_CHAT_ID=
OWNER_ID=
# your Telegram user id — DM the bot /id to learn it; only this id may /template
CHART_URL=https://web.dhan.co
# blue [[numbers]] link target (no preview); change without redeploy
# Behaviour
GROUP_WINDOW_SEC=120
ONLY_TRADED=true
DRY_RUN=true
DB_PATH=data/state.db
TOKEN_JSON=data/token.json
ORDER_WS_URL=wss://api-order-update.dhan.co
