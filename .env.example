# Copy to .env and fill in. Never commit .env.
# Dhan — token works alone (daily RenewToken cron keeps it alive).
# PIN + TOTP_SECRET optional: only for self-healing refresh after expiry.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1000000000000
TELEGRAM_ADMIN_CHAT_ID=
OWNER_ID=
# your Telegram user id — DM the bot /id to learn it; only this id may /template
CHART_URL=https://web.dhan.co
# blue [[numbers]] link target (no preview); change without redeploy
# Behaviour
GROUP_WINDOW_SEC=120
ONLY_TRADED=true
DRY_RUN=true
DB_PATH=data/state.db
TOKEN_JSON=data/token.json
