[Unit]
Description=Dhan -> Telegram trade-call bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/dhan-telegram
EnvironmentFile=/opt/dhan-telegram/.env
ExecStart=/opt/dhan-telegram/venv/bin/python main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
